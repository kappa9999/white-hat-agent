{
  "$defs": {
    "RightsDeclaration": {
      "enum": [
        "original-contribution",
        "permission-granted",
        "compatible-source-license",
        "public-domain"
      ],
      "title": "RightsDeclaration",
      "type": "string"
    },
    "SourceKind": {
      "enum": [
        "first-hand",
        "publication",
        "advisory",
        "code",
        "standard",
        "dataset",
        "other"
      ],
      "title": "SourceKind",
      "type": "string"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "accessed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accessed At"
        },
        "authors": {
          "items": {
            "type": "string"
          },
          "title": "Authors",
          "type": "array"
        },
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "source_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Source Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "source_id",
        "kind",
        "title"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contributor_handle": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Contributor Handle"
    },
    "domain_hints": {
      "items": {
        "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Domain Hints",
      "type": "array"
    },
    "original_language": {
      "default": "und",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$|^und$",
      "title": "Original Language",
      "type": "string"
    },
    "original_text": {
      "maxLength": 1000000,
      "minLength": 1,
      "title": "Original Text",
      "type": "string"
    },
    "rights": {
      "$ref": "#/$defs/RightsDeclaration"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "title": "Sources",
      "type": "array"
    },
    "submission_id": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Submission Id",
      "type": "string"
    },
    "submitted_at": {
      "format": "date-time",
      "title": "Submitted At",
      "type": "string"
    },
    "title_hint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title Hint"
    }
  },
  "required": [
    "submission_id",
    "original_text",
    "rights"
  ],
  "title": "KnowledgeSubmission",
  "type": "object"
}
