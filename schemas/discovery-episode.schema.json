      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRecord"
      },
      "title": "Evidence",
      "type": "array"
    },
    "expansions": {
      "items": {
        "$ref": "#/$defs/HypothesisExpansionRecord"
