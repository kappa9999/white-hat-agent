  "additionalProperties": false,
  "properties": {
    "completed": {
      "title": "Completed",
      "type": "boolean"
    },
    "expansion_yield": {
      "minimum": 0,
      "title": "Expansion Yield",
      "type": "number"
    },
    "improvement_targets": {
