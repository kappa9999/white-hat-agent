        },
        "graph_node_count": {
          "minimum": 0,
          "title": "Graph Node Count",
          "type": "integer"
        },
        "hypothesis_count": {
          "minimum": 0,
          "title": "Hypothesis Count",
          "type": "integer"
        },
        "progress_per_cost": {
          "minimum": 0,
          "title": "Progress Per Cost",
          "type": "number"
        },
        "refuted_count": {
          "minimum": 0,
          "title": "Refuted Count",
          "type": "integer"
