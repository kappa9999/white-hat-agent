      "required": [
        "attempt_count",
        "expansion_count",
        "hypothesis_count",
        "supported_count",
        "refuted_count",
        "evidence_count",
        "graph_node_count",
        "graph_edge_count",
        "used_cost_units",
        "total_progress",
        "progress_per_cost",
        "supported_per_cost",
        "evidence_per_cost",
        "family_coverage",
