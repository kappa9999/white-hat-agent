{
  "$defs": {
    "InstalledAdapterRecord": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Adapter Id",
          "type": "string"
        },
        "artifact_sha256": {
          "items": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "title": "Artifact Sha256",
          "type": "array"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "entrypoints": {
          "items": {
            "type": "string"
          },
          "title": "Entrypoints",
          "type": "array"
        },
        "installed_at": {
          "format": "date-time",
          "title": "Installed At",
          "type": "string"
        },
        "manifest_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Manifest Digest",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_urls": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Urls",
          "type": "array"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "adapter_id",
        "manifest_digest",
        "version",
        "revision",
        "source_urls",
        "content_sha256",
        "installed_at"
      ],
      "title": "InstalledAdapterRecord",
      "type": "object"
    },
    "ProvisionAction": {
      "enum": [
        "none",
        "install",
        "update"
      ],
      "title": "ProvisionAction",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/ProvisionAction"
    },
    "adapter_id": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Adapter Id",
      "type": "string"
    },
    "changed": {
      "title": "Changed",
      "type": "boolean"
    },
    "installed": {
      "anyOf": [
        {
          "$ref": "#/$defs/InstalledAdapterRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "plan_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Plan Digest",
      "type": "string"
    }
  },
  "required": [
    "adapter_id",
    "plan_digest",
    "action",
    "changed"
  ],
  "title": "AdapterProvisionResult",
  "type": "object"
}
