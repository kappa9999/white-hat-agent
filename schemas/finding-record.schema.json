{
  "$defs": {
    "FindingSeverity": {
      "enum": [
        "unknown",
        "informational",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "FindingSeverity",
      "type": "string"
    },
    "FindingStatus": {
      "enum": [
        "candidate",
        "supported",
        "verified",
        "refuted",
        "duplicate",
        "submitted",
        "resolved"
      ],
      "title": "FindingStatus",
      "type": "string"
    },
    "ProofTier": {
      "enum": [
        "signal",
        "reproduced",
        "causal",
        "differential",
        "regression-closed"
      ],
      "title": "ProofTier",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "campaign_id": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Campaign Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "disclosure_notes": {
      "items": {
        "type": "string"
      },
      "title": "Disclosure Notes",
      "type": "array"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "finding_id": {
      "title": "Finding Id",
      "type": "string"
    },
    "impact": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Impact"
    },
    "playbook_id": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Playbook Id",
      "type": "string"
    },
    "previous_digest": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Digest"
    },
    "proof_tier": {
      "$ref": "#/$defs/ProofTier",
      "default": "signal"
    },
    "remediation": {
      "items": {
        "type": "string"
      },
      "title": "Remediation",
      "type": "array"
    },
    "reproduction": {
      "items": {
        "type": "string"
      },
      "title": "Reproduction",
      "type": "array"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/FindingSeverity",
      "default": "unknown"
    },
    "status": {
      "$ref": "#/$defs/FindingStatus",
      "default": "candidate"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "target": {
      "minLength": 1,
      "title": "Target",
      "type": "string"
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Id"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "unknowns": {
      "items": {
        "type": "string"
      },
      "title": "Unknowns",
      "type": "array"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "finding_id",
    "campaign_id",
    "target",
    "playbook_id",
    "title",
    "summary"
  ],
  "title": "FindingRecord",
  "type": "object"
}
