{
  "$defs": {
    "ExecutionClass": {
      "enum": [
        "analysis",
        "read-only",
        "controlled-active",
        "state-changing",
        "high-impact"
      ],
      "title": "ExecutionClass",
      "type": "string"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Agent Id",
      "type": "string"
    },
    "capabilities": {
      "items": {
        "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "display_name": {
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "max_concurrency": {
      "default": 1,
      "maximum": 1000,
      "minimum": 1,
      "title": "Max Concurrency",
      "type": "integer"
    },
    "max_execution_class": {
      "$ref": "#/$defs/ExecutionClass",
      "default": "analysis"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Metadata",
      "type": "object"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    }
  },
  "required": [
    "agent_id",
    "display_name",
    "provider"
  ],
  "title": "AgentRegistration",
  "type": "object"
}
