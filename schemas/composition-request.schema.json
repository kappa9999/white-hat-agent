{
  "$defs": {
    "ExecutionClass": {
      "enum": [
        "analysis",
        "read-only",
        "controlled-active",
        "state-changing",
        "high-impact"
      ],
      "title": "ExecutionClass",
      "type": "string"
    },
    "ReviewState": {
      "enum": [
        "draft",
        "proposed",
        "reviewed",
        "validated",
        "deprecated"
      ],
      "title": "ReviewState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allowed_review_states": {
      "items": {
        "$ref": "#/$defs/ReviewState"
      },
      "title": "Allowed Review States",
      "type": "array"
    },
    "available_capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Available Capabilities",
      "type": "array"
    },
    "desired_artifacts": {
      "items": {
        "pattern": "^[a-z0-9]+(?:[._:/-][a-z0-9]+)*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Desired Artifacts",
      "type": "array"
    },
    "domains": {
      "items": {
        "type": "string"
      },
      "title": "Domains",
      "type": "array"
    },
    "execution_ceiling": {
      "$ref": "#/$defs/ExecutionClass",
      "default": "read-only"
    },
    "initial_artifacts": {
      "items": {
        "pattern": "^[a-z0-9]+(?:[._:/-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Initial Artifacts",
      "type": "array"
    },
    "max_playbooks": {
      "default": 8,
      "maximum": 100,
      "minimum": 1,
      "title": "Max Playbooks",
      "type": "integer"
    },
    "objective": {
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "platforms": {
      "items": {
        "type": "string"
      },
      "title": "Platforms",
      "type": "array"
    },
    "target_kind": {
      "minLength": 1,
      "title": "Target Kind",
      "type": "string"
    },
    "technologies": {
      "items": {
        "type": "string"
      },
      "title": "Technologies",
      "type": "array"
    }
  },
  "required": [
    "objective",
    "target_kind",
    "desired_artifacts"
  ],
  "title": "CompositionRequest",
  "type": "object"
}
