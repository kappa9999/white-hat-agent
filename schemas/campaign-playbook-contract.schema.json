{
  "$defs": {
    "ExecutionClass": {
      "enum": [
        "analysis",
        "read-only",
        "controlled-active",
        "state-changing",
        "high-impact"
      ],
      "title": "ExecutionClass",
      "type": "string"
    },
    "ReviewState": {
      "enum": [
        "draft",
        "proposed",
        "reviewed",
        "validated",
        "deprecated"
      ],
      "title": "ReviewState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action_tags": {
      "items": {
        "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Action Tags",
      "type": "array"
    },
    "capabilities": {
      "items": {
        "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Digest",
      "type": "string"
    },
    "minimum_execution_class": {
      "$ref": "#/$defs/ExecutionClass"
    },
    "minimum_request_budget": {
      "default": 0,
      "minimum": 0,
      "title": "Minimum Request Budget",
      "type": "integer"
    },
    "playbook_id": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Playbook Id",
      "type": "string"
    },
    "review_state": {
      "$ref": "#/$defs/ReviewState"
    },
    "side_effects": {
      "items": {
        "type": "string"
      },
      "title": "Side Effects",
      "type": "array"
    },
    "version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "playbook_id",
    "version",
    "digest",
    "review_state",
    "minimum_execution_class"
  ],
  "title": "CampaignPlaybookContract",
  "type": "object"
}
