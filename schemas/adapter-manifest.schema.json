{
  "$defs": {
    "AdapterKind": {
      "enum": [
        "tool",
        "knowledge"
      ],
      "title": "AdapterKind",
      "type": "string"
    },
    "AdapterLicense": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "minLength": 1,
          "title": "Attribution",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "url": {
          "pattern": "^https://",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "name",
        "url",
        "attribution"
      ],
      "title": "AdapterLicense",
      "type": "object"
    },
    "AdapterOperationBinding": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Capabilities",
          "type": "array"
        },
        "conformance_suite_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Conformance Suite Id",
          "type": "string"
        },
        "execution_class": {
          "$ref": "#/$defs/ExecutionClass"
        },
        "input_types": {
          "items": {
            "pattern": "^[a-z0-9]+(?:[._:/-][a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Input Types",
          "type": "array"
        },
        "limits": {
          "$ref": "#/$defs/OperationResourceLimits"
        },
        "modes": {
          "items": {
            "$ref": "#/$defs/ExecutionMode"
          },
          "minItems": 1,
          "title": "Modes",
          "type": "array"
        },
        "operation_id": {
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Operation Id",
          "type": "string"
        },
        "operation_version": {
          "maxLength": 64,
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Operation Version",
          "type": "string"
        },
        "output_types": {
          "items": {
            "pattern": "^[a-z0-9]+(?:[._:/-][a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Output Types",
          "type": "array"
        }
      },
      "required": [
        "operation_id",
        "operation_version",
        "capabilities",
        "execution_class",
        "modes",
        "input_types",
        "output_types",
        "conformance_suite_id",
        "limits"
      ],
      "title": "AdapterOperationBinding",
      "type": "object"
    },
    "ExecutionClass": {
      "enum": [
        "analysis",
        "read-only",
        "controlled-active",
        "state-changing",
        "high-impact"
      ],
      "title": "ExecutionClass",
      "type": "string"
    },
    "ExecutionMode": {
      "enum": [
        "offline",
        "sandbox",
        "live-readonly",
        "live-active"
      ],
      "title": "ExecutionMode",
      "type": "string"
    },
    "GitCheckoutProvisioner": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "git-checkout",
          "default": "git-checkout",
          "title": "Kind",
          "type": "string"
        },
        "max_checkout_bytes": {
          "maximum": 2147483648,
          "minimum": 1,
          "title": "Max Checkout Bytes",
          "type": "integer"
        },
        "ref": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "repository": {
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:\\.git)?$",
          "title": "Repository",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "ref",
        "max_checkout_bytes"
      ],
      "title": "GitCheckoutProvisioner",
      "type": "object"
    },
    "GitHubReleaseProvisioner": {
      "additionalProperties": false,
      "properties": {
        "asset_patterns": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Asset Patterns",
          "type": "object"
        },
        "entrypoints": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Entrypoints",
          "type": "object"
        },
        "kind": {
          "const": "github-release",
          "default": "github-release",
          "title": "Kind",
          "type": "string"
        },
        "max_download_bytes": {
          "maximum": 2147483648,
          "minimum": 1,
          "title": "Max Download Bytes",
          "type": "integer"
        },
        "max_install_bytes": {
          "maximum": 8589934592,
          "minimum": 1,
          "title": "Max Install Bytes",
          "type": "integer"
        },
        "repository": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "title": "Repository",
          "type": "string"
        },
        "strip_single_directory": {
          "default": true,
          "title": "Strip Single Directory",
          "type": "boolean"
        }
      },
      "required": [
        "repository",
        "asset_patterns",
        "max_download_bytes",
        "max_install_bytes"
      ],
      "title": "GitHubReleaseProvisioner",
      "type": "object"
    },
    "OperationResourceLimits": {
      "additionalProperties": false,
      "properties": {
        "cpu_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 86400,
          "title": "Cpu Seconds",
          "type": "integer"
        },
        "max_files": {
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Max Files",
          "type": "integer"
        },
        "max_input_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 2147483648,
          "title": "Max Input Bytes",
          "type": "integer"
        },
        "max_output_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 2147483648,
          "title": "Max Output Bytes",
          "type": "integer"
        },
        "max_processes": {
          "exclusiveMinimum": 0,
          "maximum": 4096,
          "title": "Max Processes",
          "type": "integer"
        },
        "max_records": {
          "exclusiveMinimum": 0,
          "maximum": 10000000,
          "title": "Max Records",
          "type": "integer"
        },
        "memory_mib": {
          "exclusiveMinimum": 0,
          "maximum": 1048576,
          "title": "Memory Mib",
          "type": "integer"
        },
        "wall_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 86400,
          "title": "Wall Seconds",
          "type": "integer"
        }
      },
      "required": [
        "max_input_bytes",
        "max_output_bytes",
        "max_files",
        "max_records",
        "wall_seconds",
        "cpu_seconds",
        "memory_mib",
        "max_processes"
      ],
      "title": "OperationResourceLimits",
      "type": "object"
    },
    "ProbeDefinition": {
      "additionalProperties": false,
      "properties": {
        "executable_names": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Executable Names",
          "type": "object"
        },
        "minimum_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Version"
        },
        "timeout_seconds": {
          "default": 10.0,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "version_args": {
          "anyOf": [
            {
              "maxItems": 1,
              "minItems": 1,
              "prefixItems": [
                {
                  "const": "--version",
                  "type": "string"
                }
              ],
              "type": "array"
            },
            {
              "maxItems": 1,
              "minItems": 1,
              "prefixItems": [
                {
                  "const": "-version",
                  "type": "string"
                }
              ],
              "type": "array"
            },
            {
              "maxItems": 0,
              "minItems": 0,
              "type": "array"
            }
          ],
          "default": [
            "--version"
          ],
          "title": "Version Args"
        },
        "version_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version File"
        },
        "version_pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version Pattern"
        },
        "version_property": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version Property"
        }
      },
      "required": [
        "executable_names"
      ],
      "title": "ProbeDefinition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adapter_id": {
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Adapter Id",
      "type": "string"
    },
    "adapter_version": {
      "default": "1.0.0",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Adapter Version",
      "type": "string"
    },
    "capabilities": {
      "items": {
        "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Capabilities",
      "type": "array"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/AdapterKind"
    },
    "license": {
      "$ref": "#/$defs/AdapterLicense"
    },
    "max_execution_class": {
      "$ref": "#/$defs/ExecutionClass",
      "default": "analysis"
    },
    "modes": {
      "items": {
        "$ref": "#/$defs/ExecutionMode"
      },
      "title": "Modes",
      "type": "array"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/AdapterOperationBinding"
      },
      "title": "Operations",
      "type": "array"
    },
    "platforms": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Platforms",
      "type": "array"
    },
    "priority": {
      "default": 50,
      "maximum": 100,
      "minimum": 0,
      "title": "Priority",
      "type": "integer"
    },
    "probe": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProbeDefinition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "provider_url": {
      "pattern": "^https://",
      "title": "Provider Url",
      "type": "string"
    },
    "provisioner": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "git-checkout": "#/$defs/GitCheckoutProvisioner",
              "github-release": "#/$defs/GitHubReleaseProvisioner"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/GitHubReleaseProvisioner"
            },
            {
              "$ref": "#/$defs/GitCheckoutProvisioner"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provisioner"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/ProbeDefinition"
      },
      "maxItems": 32,
      "title": "Requirements",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "search_globs": {
      "items": {
        "type": "string"
      },
      "title": "Search Globs",
      "type": "array"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "adapter_id",
    "title",
    "description",
    "kind",
    "provider",
    "provider_url",
    "license",
    "capabilities",
    "platforms",
    "updated_at"
  ],
  "title": "AdapterManifest",
  "type": "object"
}
